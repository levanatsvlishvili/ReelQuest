# ==========================================
# ReelQuest .gitignore
# Enterprise Serverless Monorepo
# ==========================================

# -----------------
# Operating System & IDEs
# -----------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -----------------
# Java & Maven
# -----------------
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# -----------------
# Node.js & Frontend
# -----------------
node_modules/
dist/
dist-ssr/
build/
coverage/
*.lcov
.nyc_output/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------
# Terraform & Cloud IaC
# -----------------
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# -----------------
# Python & Scripts (ETL)
# -----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.tsv
*.tsv.gz

# -----------------
# Secrets & Environment Variables
# -----------------
.env
.env.*
!.env.example
secrets.json
*.pem
*.key
plan.txt
